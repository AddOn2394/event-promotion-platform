{
  "openapi": "3.0.0",
  "info": {
    "title": "Feria de Promociones — API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ConfirmarAsistenciaItem": {
        "type": "object",
        "properties": {
          "catalogoItemId": {
            "type": "string",
            "format": "uuid"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "servicio",
              "producto"
            ]
          }
        },
        "required": [
          "catalogoItemId",
          "categoria"
        ]
      },
      "ConfirmarAsistenciaRequest": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "catalogoItemId": {
                  "type": "string",
                  "format": "uuid"
                },
                "categoria": {
                  "type": "string",
                  "enum": [
                    "servicio",
                    "producto"
                  ]
                }
              },
              "required": [
                "catalogoItemId",
                "categoria"
              ]
            },
            "minItems": 1
          },
          "slotId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "items",
          "slotId"
        ]
      },
      "ConfirmarAsistenciaResponse": {
        "type": "object",
        "properties": {
          "subtotalServiciosCents": {
            "type": "integer",
            "minimum": 0
          },
          "descuentoServiciosPct": {
            "type": "integer"
          },
          "subtotalProductosCents": {
            "type": "integer",
            "minimum": 0
          },
          "descuentoProductosPct": {
            "type": "integer"
          },
          "totalCents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "subtotalServiciosCents",
          "descuentoServiciosPct",
          "subtotalProductosCents",
          "descuentoProductosPct",
          "totalCents"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/confirmaciones": {
      "post": {
        "description": "HU-3 / HU-7 — confirmar (o reconfirmar) asistencia",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmarAsistenciaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmación registrada — subtotales, % de descuento y total en centavos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmarAsistenciaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Selección vacía o slotId inválido — rechazado por el schema compartido (HU-3, G0)"
          },
          "409": {
            "description": "Ya existe una confirmación 'confirmada' para esta invitación (HU-3/HU-7 vía PATCH, no un segundo POST)"
          }
        }
      }
    }
  }
}
