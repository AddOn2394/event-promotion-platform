# Copiar a .env (gitignorado) para docker-compose local. No commitear valores reales.
POSTGRES_USER=event_promotion
POSTGRES_PASSWORD=changeme
POSTGRES_DB=event_promotion

# Solo para correr apps/api FUERA de docker (dev:api, db:migrate, tests): docker-compose la arma
# solo para los contenedores, así que NO va en el .env — se exporta en la shell (ver README).
# Sin ella, todo endpoint con DB responde 500 "Error interno" (SASL: client password must be a
# string). Dev: .../event_promotion — tests de integración: .../event_promotion_test.
# export DATABASE_URL=postgres://event_promotion:<POSTGRES_PASSWORD>@localhost:5432/event_promotion

# Cuenta admin seed (ADR-013) — usada por apps/api/src/db/seed.ts. Cambiar en producción.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Firma de JWT (cookies httpOnly, ADR-011/ADR-013). Generar un string largo/aleatorio real.
JWT_SECRET=changeme-usar-un-secreto-largo-y-aleatorio

# Resend (ADR-015) — API key real en https://resend.com/api-keys. onboarding@resend.dev es
# el remitente sandbox: solo entrega al email con el que te registraste en Resend. Basta la
# dirección: el correo sale como "Feria de Promociones <dirección>" (o se puede poner ya con
# ese formato). Con NODE_ENV=test el mailer no envía nada, aunque estas variables estén.
RESEND_API_KEY=changeme
RESEND_FROM_EMAIL=onboarding@resend.dev

# Secreto de verificación del webhook de Resend (ADR-024, Gate 5) — se obtiene al crear el
# webhook en el dashboard de Resend (Svix, formato "whsec_..."). POST /webhooks/resend
# rechaza cualquier payload cuya firma no verifique contra este secreto.
RESEND_WEBHOOK_SECRET=changeme

# URL pública del frontend — se usa para armar el link del correo de invitación (ADR-011)
# y como origin permitido de CORS.
FRONTEND_URL=http://localhost:5173

# true solo cuando la API corre detrás de HTTPS real (Render) — controla el atributo
# Secure/SameSite de las cookies de sesión. NODE_ENV no sirve para esto: el Dockerfile
# lo fija a "production" incluso en docker-compose local sobre HTTP simple.
COOKIE_SECURE=false
